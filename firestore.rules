rules_version = '2';

// Règles de sécurité — Cabinet Privé de Soins DEO-GRACIAS
//
// • Personnel (appareil activé avec le compte du cabinet) : accès complet.
// • Patients du portail public (connexion anonyme) : peuvent seulement
//   - lire la liste des médecins actifs,
//   - déposer une demande de RDV,
//   - lire et annuler LEURS PROPRES demandes.
//   Aucun accès aux consultations, dossiers, sauvegardes, etc.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isStaff() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isOwnRequest() {
      return isSignedIn() && resource.data.patientUid == request.auth.uid;
    }

    // Refuse les caractères < et > (empêche d'injecter du HTML / script dans les fiches imprimées).
    function sansBalise(t) {
      return !t.matches('(?s).*[<>].*');
    }

    function isValidPatientRequest() {
      let d = request.resource.data;
      return d.keys().hasOnly(['type', 'source', 'medecinId', 'medecinNom', 'date', 'heure',
                               'moment', 'patientNom', 'patientTel', 'motif', 'statut',
                               'createdAt', 'patientUid'])
        && d.patientUid == request.auth.uid
        && d.statut == 'Demandé'
        && d.heure == ''
        // Chaque champ est vérifié ici, côté serveur : impossible à contourner depuis le navigateur.
        && d.type == 'demande'
        && d.source == 'portail_patient'
        && (d.medecinId == null || (d.medecinId is string && d.medecinId.size() <= 64))
        && d.medecinNom is string && d.medecinNom.size() <= 150 && sansBalise(d.medecinNom)
        && d.moment is string && d.moment.size() <= 30 && sansBalise(d.moment)
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.patientNom is string && d.patientNom.size() >= 2 && d.patientNom.size() <= 100 && sansBalise(d.patientNom)
        && d.patientTel is string && d.patientTel.matches('^[0-9]{8,15}$')
        && d.motif is string && d.motif.size() <= 300 && sansBalise(d.motif)
        && d.createdAt is number;
    }

    // Médecins proposés aux patients
    match /medecins/{medecinId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    // Rendez-vous en ligne
    match /rdv/{rdvId} {
      allow read: if isStaff() || isOwnRequest();
      allow create: if isStaff() || (isSignedIn() && isValidPatientRequest());
      // Le patient peut seulement annuler sa propre demande encore en attente
      allow update: if isStaff() || (
        isOwnRequest()
        && resource.data.statut == 'Demandé'
        && request.resource.data.statut == 'Annulé'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['statut', 'annulePar', 'annuleLe'])
      );
      allow delete: if isStaff();
    }

    // Tout le reste (consultations, synchro, sauvegardes, personnel…) : personnel uniquement
    match /{document=**} {
      allow read, write: if isStaff();
    }
  }
}
